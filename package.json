{
  "name": "sites-project",
  "version": "0.1.18",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "dev:desktop": "vite --config vite.desktop.config.ts --host 127.0.0.1 --port 1420",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "build:apache": "vite build --config vite.apache.config.ts && node scripts/package-apache.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "data:build": "node scripts/build-app-data.mjs",
    "data:normalize": "node scripts/normalize-profile-data.mjs",
    "data:validate": "node scripts/validate-license-data.mjs",
    "data:validate:release": "node scripts/validate-license-data.mjs --release",
    "data:profiles:check": "node scripts/sync-license-profiles.mjs --check",
    "data:runtime:check": "node scripts/sync-runtime-metadata.mjs --check",
    "data:runtime:write": "node scripts/sync-runtime-metadata.mjs --write",
    "data:audit": "node scripts/metadata-audit.mjs",
    "data:profiles:write": "node scripts/sync-license-profiles.mjs --write",
    "data:curate:legacy": "node scripts/curate-legacy-profiles.mjs",
    "test:data": "node --test scripts/validate-license-data.test.mjs",
    "test:hosting-config-boundary": "node --test scripts/hosting-config-boundary.test.mjs",
    "test:metadata-audit": "node --test scripts/metadata-audit.test.mjs",
    "test:recommendation-contract": "node --experimental-strip-types --test scripts/recommendation-contract.test.ts",
    "test:guide-contract": "node --experimental-strip-types --test scripts/guide-contract.test.ts",
    "test:mcp-contract": "node --experimental-strip-types --test scripts/mcp-contract.test.ts",
    "test:apache-recommendation-contract": "php scripts/apache-recommendation-contract.test.php",
    "data:signals:refresh": "node --experimental-strip-types scripts/refresh-github-signals.ts",
    "test:signals-contract": "node --experimental-strip-types --test scripts/signals-contract.test.ts",
    "test:curation": "node --test scripts/curate-legacy-profiles.test.mjs",
    "test:data-build": "node --test scripts/build-app-data.test.mjs",
    "test:runtime-metadata": "node --test scripts/runtime-metadata-adapter.test.mjs",
    "test:public-api-policy": "node --experimental-strip-types --test scripts/public-api-policy.test.ts",
    "test:apache-public-api-policy": "php scripts/apache-public-api-policy.test.php",
    "test:apache-anonymous-entry": "node --experimental-strip-types --test scripts/apache-anonymous-entry.test.ts",
    "start": "vinext start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:data && npm run test:hosting-config-boundary && npm run test:metadata-audit && npm run test:recommendation-contract && npm run test:guide-contract && npm run test:mcp-contract && npm run test:catalog-service && npm run test:apache-recommendation-contract && npm run test:curation && npm run test:data-build && npm run test:runtime-metadata && npm run test:public-api-policy && npm run test:signals-contract && npm run test:apache-public-api-policy && npm run test:apache-anonymous-entry && npm run test:workspace-state && npm run test:service-worker-policy && npm run test:guide-expansion && npm run test:content-review-workflow",
    "test:catalog-service": "node --experimental-strip-types --test scripts/catalog-service.test.ts",
    "test:workspace-state": "node --experimental-strip-types --test scripts/workspace-state.test.ts",
    "test:service-worker-policy": "node --test scripts/service-worker-policy.test.mjs",
    "check": "npm run typecheck && npm run lint -- --max-warnings=0 && npm test && npm run data:validate:release && npm run data:profiles:check && npm run data:runtime:check && npm run data:guide:check && npm run data:reviews:check",
    "lint": "eslint .",
    "data:guide:report": "node --experimental-strip-types scripts/guide-inclusion-report.ts",
    "data:guide:check": "node --experimental-strip-types scripts/guide-inclusion-report.ts --check",
    "test:guide-expansion": "node --experimental-strip-types --test scripts/guide-expansion.test.ts",
    "data:reviews:report": "node --experimental-strip-types scripts/content-review-workflow.mjs",
    "data:reviews:check": "node --experimental-strip-types scripts/content-review-workflow.mjs --check --require-complete",
    "test:content-review-workflow": "node --experimental-strip-types --test scripts/content-review-workflow.test.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.3",
    "better-auth": "^1.7.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "^0.35.4"
    }
  },
  "type": "module"
}
